DATABASE_URL=
SECRET_KEY=
GOOGLE_TRANSLATION_API_KEY=
CORS_ORIGINS=
ADMIN_TOKEN=
OCR_ENGINE=paddleocr

# English mobile OCR for upright documents. Warm at startup; bound raster memory.
OCR_MAX_SIDE=1600
OCR_LINE_ORIENTATION=0
OCR_PRELOAD=1

# Recognition batches and optional crop-retry budget (not a hard latency guarantee).
OCR_REC_BATCH_SIZE=1
OCR_RETRY_BUDGET_SECONDS=8

# Local two-mode Tesseract fast pass for complete, confident core fields; Paddle fallback.
OCR_FAST_TEXT_PASS=1
OCR_CPU_THREADS=2
OCR_DET_MAX_SIDE=960

# Generate once with Fernet.generate_key(); keep outside source control and back up securely.
IDENTITY_ENCRYPTION_KEY=
IDENTITY_ENCRYPTION_REQUIRED=0

# Deployment-only: persistent paths and exact production frontend HTTPS origin.
# SQLITE_PATH=/var/data/sahayak.db
# UPLOAD_FOLDER=/var/data/uploads
# FRONTEND_ORIGIN=https://your-project.vercel.app
# SESSION_COOKIE_SECURE=true
