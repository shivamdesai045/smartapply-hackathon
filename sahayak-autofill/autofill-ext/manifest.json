{
  "manifest_version": 3,
  "name": "Sahayak AutoFill",
  "version": "0.4.1",
  "description": "Save your corrected details once (encrypted with your passphrase), then fill simple form fields on a page. You review everything and submit yourself.",
  "action": {
    "default_title": "Open Sahayak AutoFill",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
